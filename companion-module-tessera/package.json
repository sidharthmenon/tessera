{
  "name": "tessera",
  "version": "0.3.0",
  "description": "Bitfocus Companion connection for the Tessera media server",
  "main": "dist/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "npm run build && node --test dist/*.test.js",
    "package": "npm run build && companion-module-build",
    "smoke": "npm run build && node dist/smoke.js"
  },
  "engines": {
    "node": "^22.11"
  },
  "dependencies": {
    "@companion-module/base": "~1.12.1"
  },
  "devDependencies": {
    "@companion-module/tools": "^2.9.1",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
