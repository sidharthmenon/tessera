<plist version="1.0">
<dict>
	<!-- Live inputs (capture cards, USB capture, cameras): without this macOS stops the engine
	     when it opens a camera. Tauri merges this file into the bundle's Info.plist. -->
	<key>NSCameraUsageDescription</key>
	<string>Tessera shows capture cards and cameras as live inputs on your screens.</string>
</dict>
</plist>
