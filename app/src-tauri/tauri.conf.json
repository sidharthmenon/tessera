{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tessera",
  "version": "0.1.0",
  "identifier": "dev.tessera.controller",
  "build": {
    "beforeDevCommand": "sh ../scripts/build-engine.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh ../scripts/build-engine.sh release && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Tessera",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tessera-engine"
    ]
  }
}
